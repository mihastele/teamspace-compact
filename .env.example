# Client configuration: Firebase Console > Project settings > Web app.
BACKEND_PROVIDER=firebase
NEXT_PUBLIC_BACKEND_PROVIDER=firebase
EMAIL_CONFIRMATION_REQUIRED=true
PASSWORD_AUTH_ENABLED=true
GOOGLE_AUTH_ENABLED=true
# Server-only comma-separated provider account IDs. Empty means no root admins.
ROOT_ADMIN_UIDS=
# Optional existing test workspace, accepted only by next dev. Never set in production.
DEV_AUTO_JOIN_WORKSPACE_ID=

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server only. Never expose through NEXT_PUBLIC or commit populated values.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
