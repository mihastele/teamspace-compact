# Copy to .env.supabase for Docker, and app variables to .env.local/Vercel.
# Empty secrets are deliberate. Generate fresh values; never commit .env.supabase.
BACKEND_PROVIDER=supabase
NEXT_PUBLIC_BACKEND_PROVIDER=supabase
EMAIL_CONFIRMATION_REQUIRED=true
PASSWORD_AUTH_ENABLED=true
GOOGLE_AUTH_ENABLED=false
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=http://localhost:8000
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=teamspace-private

# Official Docker stack: generate keys using upstream utils/generate-keys.sh.
# ANON_KEY/SERVICE_ROLE_KEY must be signed using this JWT_SECRET.
# App keys above must correspond to this same server, not another project.
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
JWT_KEYS=
JWT_JWKS=
DASHBOARD_USERNAME=teamspace-admin
DASHBOARD_PASSWORD=
SECRET_KEY_BASE=
REALTIME_DB_ENC_KEY=
VAULT_ENC_KEY=
PG_META_CRYPTO_KEY=
S3_PROTOCOL_ACCESS_KEY_ID=
S3_PROTOCOL_ACCESS_KEY_SECRET=

POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
API_GW_HTTP_PORT=8000
POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_TENANT_ID=teamspace
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_DB_POOL_SIZE=5
SUPABASE_PUBLIC_URL=http://localhost:8000
# Auth base URL includes /auth/v1; the public/client URL above does not.
API_EXTERNAL_URL=http://localhost:8000/auth/v1
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=http://localhost:3000/
JWT_EXPIRY=3600
PGRST_DB_SCHEMAS=public,storage,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
FUNCTIONS_VERIFY_JWT=true
IMGPROXY_AUTO_WEBP=true
STORAGE_TENANT_ID=teamspace
GLOBAL_S3_BUCKET=stub
REGION=local
STUDIO_DEFAULT_ORGANIZATION=Teamspace
STUDIO_DEFAULT_PROJECT=Teamspace
OPENAI_API_KEY=

# Required for verification/password reset emails in a production self-hosted setup.
SMTP_ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Teamspace
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

# Optional Google OAuth; leave disabled for classic email/password login only.
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
